# =============================================================================
# STAGE 1 — K1 training base image
# nvcr.io/nvidia/isaac-lab:3.0.0-beta2-post1 — WARNING: despite the tag this
# image ships Isaac Lab 6.1.16 (verified 2026-08). Kept for future 6.x
# migration; NOT compatible with the workspace 3.0.0b2 task code.
#   + pinned rsl-rl (5.0.1, matches local training runs)
#   + wandb / huggingface_hub
#   + git + git-lfs
#   + OPTIONAL: ROS 2 Jazzy base + teleop packages (INSTALL_ROS=1, default)
#   + OPTIONAL: mjlab (INSTALL_MJLAB=1, default off)
#
# Build:
#   docker build -f docker/Dockerfile.base \
#     --build-arg INSTALL_ROS=1 --build-arg INSTALL_MJLAB=0 \
#     -t <dockerhub-user>/k1-isaac-base:3.0.0b2 .
#
# Push (your account):
#   docker push <dockerhub-user>/k1-isaac-base:3.0.0b2
#
# NOTE: ~25 GB unpacked. Do NOT build on machines with < 40 GB free.
# =============================================================================
FROM nvcr.io/nvidia/isaac-lab:3.0.0-beta2-post1

ARG INSTALL_ROS=1
ARG INSTALL_MJLAB=0
ARG RSL_RL_VERSION=5.0.1
ARG ROS_DISTRO=jazzy

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# ---------- system deps ----------
RUN apt-get update && apt-get install -y --no-install-recommends \
        git git-lfs curl wget ca-certificates build-essential \
        tmux htop nano less \
    && rm -rf /var/lib/apt/lists/*
RUN git lfs install

# ---------- resolve the image's Isaac python (defensive across layouts) ----------
RUN set -e; \
    if command -v isaaclab >/dev/null 2>&1; then \
        echo "isaaclab -p" > /etc/k1_python; \
    elif [ -f /workspace/isaaclab/isaaclab.sh ]; then \
        echo "/workspace/isaaclab/isaaclab.sh -p" > /etc/k1_python; \
    elif [ -f /isaac-sim/python.sh ]; then \
        echo "/isaac-sim/python.sh" > /etc/k1_python; \
    else \
        echo "python3" > /etc/k1_python; \
    fi; \
    cat /etc/k1_python

# ---------- python deps (into the Isaac env) ----------
RUN PY="$(cat /etc/k1_python)" && $PY -m pip install --no-cache-dir \
        "rsl-rl-lib==${RSL_RL_VERSION}" \
        wandb \
        huggingface_hub \
        "numpy<2.6" \
    && $PY -c "import rsl_rl, wandb; print('rsl_rl', rsl_rl.__version__)"

# ---------- optional: ROS 2 Jazzy + teleop ----------
# Installed but NOT sourced into Isaac processes by default (RMW double-init
# hazard — see workspace CLAUDE.md). Source on demand: K1_SOURCE_ROS=1.
RUN if [ "$INSTALL_ROS" = "1" ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            software-properties-common gnupg lsb-release \
        && add-apt-repository universe -y \
        && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
            -o /usr/share/keyrings/ros-archive-keyring.gpg \
        && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
            > /etc/apt/sources.list.d/ros2.list \
        && apt-get update && apt-get install -y --no-install-recommends \
            ros-${ROS_DISTRO}-ros-base \
            ros-${ROS_DISTRO}-teleop-twist-keyboard \
            ros-${ROS_DISTRO}-joy \
            ros-${ROS_DISTRO}-robot-state-publisher \
            ros-${ROS_DISTRO}-joint-state-publisher-gui \
            ros-jazzy-ros2-control ros-jazzy-ros2-controllers \
        && rm -rf /var/lib/apt/lists/*; \
    fi

# ---------- optional: mjlab (MuJoCo-based GPU sim) ----------
RUN if [ "$INSTALL_MJLAB" = "1" ]; then \
        PY="$(cat /etc/k1_python)" && \
        $PY -m pip install --no-cache-dir \
            "git+https://github.com/mujocolab/mjlab.git"; \
    fi

# ---------- entry hooks ----------
# K1_SOURCE_ROS=1 (non-Isaac workflows only!) sources the ROS overlay.
RUN printf '# K1 ROS hook — opt-in\nif [ "${K1_SOURCE_ROS:-0}" = "1" ] && [ -f /opt/ros/%s/setup.bash ]; then\n  source /opt/ros/%s/setup.bash\nfi\n' "${ROS_DISTRO}" "${ROS_DISTRO}" > /etc/profile.d/k1_ros.sh \
    && chmod +x /etc/profile.d/k1_ros.sh

COPY entrypoint.sh /usr/local/bin/k1-entrypoint.sh
RUN chmod +x /usr/local/bin/k1-entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/k1-entrypoint.sh"]
CMD ["--task", "Isaac-Velocity-Rough-K1-Teacher-v0", "--num_envs", "4096", "--headless"]
