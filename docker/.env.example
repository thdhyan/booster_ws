# =============================================================================
# K1 training container secrets — COPY to docker/.env and fill in.
# docker/.env is GITIGNORED. Never bake these into images.
#
# Used by: docker/run.sh (docker --env-file) and apptainer --env-file.
# =============================================================================
# Weights & Biases (https://wandb.ai/authorize)
WANDB_API_KEY=
# Hugging Face (https://huggingface.co/settings/tokens) — read scope is enough
HF_TOKEN=
# GitHub PAT (classic, repo scope) — ONLY needed if the repo/submodules are
# private; leave empty for public clones
GITHUB_TOKEN=
# Optional wandb mode: online (default) | offline | disabled
WANDB_MODE=online
