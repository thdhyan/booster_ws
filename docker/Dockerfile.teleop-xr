# Quest 3 teleop for the K1 (k1_teleop/xr_teleop_node.py) + the YOLO node.
# Copy of G1_sim docker/Dockerfile.teleop-xr-spark (9c3c429), plus ultralytics.
# Isaac Teleop's wheels bundle the CloudXR runtime + Televiz (x86_64 and
# aarch64), so there is no source build. CUDA 12.9 runtime for CuPy frame
# upload; ROS Jazzy for the /k1_0/* topics. Code is bind-mounted from the repo.
# Rebuild per host architecture (dl x86_64 vs Spark aarch64).
FROM nvidia/cuda:12.9.1-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    NVIDIA_DRIVER_CAPABILITIES=all \
    VK_DRIVER_FILES=/etc/vulkan/icd.d/nvidia_icd.json \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl gnupg ca-certificates python3-venv python3-pip \
        libvulkan1 libegl1 libgl1 libglx0 libx11-6 libxext6 libxrandr2 libxinerama1 \
        libxcursor1 libxi6 libxxf86vm1 libnss3 libusb-1.0-0 libudev1 \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc \
        | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu noble main" > /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends ros-jazzy-ros-base ros-jazzy-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

# NVIDIA Vulkan + EGL ICDs (as in IsaacTeleop's teleop_ros2 image); the
# libraries themselves come from the host driver via the NVIDIA runtime.
RUN mkdir -p /etc/vulkan/icd.d /usr/share/glvnd/egl_vendor.d \
    && printf '{"file_format_version":"1.0.0","ICD":{"library_path":"libGLX_nvidia.so.0","api_version":"1.3.194"}}\n' \
        > /etc/vulkan/icd.d/nvidia_icd.json \
    && printf '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}\n' \
        > /usr/share/glvnd/egl_vendor.d/10_nvidia.json

# venv on the system Python 3.12 so rclpy (system site-packages) stays importable;
# numpy pinned to ROS's Debian build.
RUN python3 -m venv --system-site-packages /opt/venv \
    && /opt/venv/bin/pip install \
        "isaacteleop[cloudxr,retargeters-lite]==1.4.145" \
        "cupy-cuda12x<14" "opencv-python-headless<4.12" aiohttp \
        numpy==1.26.4
# CPU torch: HMD-Poser (~10 ms/window) and YOLOv8n on the CPU
RUN /opt/venv/bin/pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && /opt/venv/bin/pip install ultralytics numpy==1.26.4 "opencv-python-headless<4.12"

# Cyclone, as in the G1 image: Fast DDS here <-> the sim's bundled Fast DDS on the same
# host picks shared memory across containers/users and delivers nothing (dl, 2026-09-28)
ENV PATH=/opt/venv/bin:$PATH \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
