  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: k1_0/pelvis
    Frame Rate: 30
  Global Clock:
    Use sim time: false
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7854
      Focal Frame: k1_0/pelvis
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current
      Near Clip Distance: 0.01
      Pitch: 0.5
      Target Frame: k1_0/pelvis
      Yaw: 0.785

Window Geometry:
  Displays:
    collapsed: false
  Height: 1080
  Width: 1920
  X: 0
  Y: 0