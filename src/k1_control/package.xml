<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>k1_control</name>
  <version>0.1.0</version>
  <description>Bridge between ROS2 JointCommand msgs and control backends (SDK for real robot, passthrough for sim)</description>
  <maintainer email="th.dhyan.us@gmail.com">Booster K1</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>python3-dev</build_depend>
  <build_depend>ament_python</build_depend>

  <depend>rclpy</depend>
  <depend>k1_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
